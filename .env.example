# ============================================================
# Recetario Inteligente — Variables de entorno
# ============================================================
# Copia este archivo como ".env" y completa los valores:
#
#   cp .env.example .env
#
# NUNCA subas el archivo .env al repositorio.
# Ya está excluido en .gitignore.
# ============================================================

# URL del proyecto Supabase (sin barra final)
# Encuéntrala en: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave anon (pública) del proyecto Supabase
# Encuéntrala en: Supabase Dashboard → Project Settings → API → anon public key
# Esta clave es segura para usar en el frontend (RLS la protege).
VITE_SUPABASE_ANON_KEY=tu-clave-anon-aqui

# ------------------------------------------------------------
# IMPORTANTE: La clave de OpenRouter NO va en este archivo.
# Se configura como secreto de la Edge Function en Supabase:
#
#   Supabase Dashboard → Edge Functions → Secrets
#
#   Nombre:  OPENROUTER_API_KEY
#   Valor:   tu-clave-de-openrouter
#
# La Edge Function la lee desde el servidor con Deno.env.get().
# NUNCA debe exponerse en el frontend ni commitearse.
# ------------------------------------------------------------
